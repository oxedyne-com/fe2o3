// The named colours and the alignment and direction constants are also in their type's scope
// (`color.black` in note-me, `alignment.center` in modern-buaa-thesis).
#text(fill: color.fuchsia.darken(50%))[Dark] #text(fill: color.black)[Black]
#align(alignment.center)[Centred]
#align(alignment.top + alignment.right)[Top right]
#repr(color.blue) #repr(alignment.horizon) #repr(direction.ltr) #(color.red == red)
