# Ignore files that do not have an extension (typically executable files)
*
!*/
!*.*

# Agent worktrees. These are a checkout apiece, so a blanket `git add` in a tree
# several sessions share would commit a copy of the repository into itself.
.claude/worktrees/

# Rust
/target/
#Cargo.lock # removed for reproducible app builds, e.g. fe2o3_steel
**/*.rs.bk

# SABER C static libraries (regenerated by fe2o3_crypto/build.rs)
fe2o3_crypto/src/c/lib*.a

# Ozone test artefacts (regenerated by test runs)
fe2o3_o3db_sync/test_db*/

# Logs
*.log

# Source code text file bundles
txtcat_*.txt

# Vim
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.bak
.commit_msg.txt

# OS specific
.DS_Store
.directory
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

.srcat/

# The two Unicode bidi conformance suites are 15 MB between them. They are fetched on demand
# by fe2o3_text/tests/unicode.rs, at the UCD version the committed tables were generated from.
fe2o3_text/tests/unicode_data/BidiTest.txt
fe2o3_text/tests/unicode_data/BidiCharacterTest.txt

# The Ore replica. Its store, its bookkeeping and the git mirror it writes all
# live here, and none of it belongs in git.
/.ore/

# Ore reads only the root ignore file, so the rules a nested .gitignore holds
# are repeated here. Unanchored and directory-only, `target/` also catches a
# build directory under a subcrate, which `/target/` above would let through
# into a log that cannot forget it.
target/
fe2o3_namex/namex_echo.jdat
fe2o3_namex/namex_echo.json
