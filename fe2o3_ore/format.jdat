    "open": [
        {
            "question": "the spelling of the flag that says a segment is compressed",
            "why":      "every reader of a segment has to agree on it, and a reader that brings the wrong spelling reads nonsense rather than an error",
            "asked":    "12026-08-21",
            "note":     "segment_compression.md",
            "guard":    ["KIND_COMPRESSED", "COMPRESSED", "COMPRESSION", "compressed", "compression"]
        },
        {
            "question": "which axis the flag sits on: a header field, a kind byte, or the version",
            "why":      "it decides whether segment::VERSION moves and whether the two segment golden tests move with it. The veiling precedent says a container change need cost neither",
            "asked":    "12026-08-21",
            "note":     "segment_compression.md",
            "guard":    ["COMPRESS_AXIS"]
        },
        {
            "question": "which compression algorithm, named on the wire or implied by the version",
            "why":      "a reader that brings the wrong one gets nonsense, not an error",
            "asked":    "12026-08-21",
            "note":     "segment_compression.md",
            "guard":    ["ALGO_ZSTD", "ALGO_DEFLATE", "COMPRESS_ALGO", "zstd", "flate2"]
        },
        {
            "question": "whether the compression level is recorded in the segment",
            "why":      "it changes the bytes and nothing else, and recording it invites a test to freeze it, which would freeze a dependency version and call it a format",
            "asked":    "12026-08-21",
            "note":     "segment_compression.md",
            "guard":    ["COMPRESS_LEVEL", "LEVEL_DEFAULT"]
        },
        {
            "question": "whether segment::VERSION rises for compression",
            "why":      "the rule the vocabulary grows by is about operation codes, and compression adds no operation, so the rule does not decide this on its own",
            "asked":    "12026-08-21",
            "note":     "segment_compression.md",
            "guard":    []
        }
    ]
}
