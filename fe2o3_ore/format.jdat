            "path":     "src/op.rs",
            "role":     "the operation vocabulary and the values inside an operation",
            "exempt":   []
        },
        {
            "path":     "src/sync/msg.rs",
            "role":     "the sync message frame",
            "exempt":   []
        }
    ],

