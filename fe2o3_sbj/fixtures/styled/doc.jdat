(sbj_doc|(map|{
    (str|"children"): (list|[
        (sbj_box|(map|{
            (str|"children"): (list|[
                (sbj_para|(map|{
                    (str|"children"): (list|[
                        (sbj_text|(str|"A lede paragraph in a callout box.")),
                    ]),
                    (str|"style"): (str|"lede"),
                })),
            ]),
            (str|"style"): (str|"callout"),
        })),
    ]),
    (str|"lang"): (str|"en"),
    (str|"styles"): (map|{
